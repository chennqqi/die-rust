/target/
**/target/
__pycache__/
*.py[cod]
# Exception: fuzz corpus .pyc files are test seeds, not Python bytecode
!fuzz/corpus/**/*.pyc
/aqtinstall.log
# die-gui: copied data dirs for installer bundling (not source-controlled)
/crates/die-gui/db/
/crates/die-gui/db_extra/
/crates/die-gui/db_custom/
/crates/die-gui/dbs_min/
/crates/die-gui/dbs_special/
/crates/die-gui/peid_rules/
/crates/die-gui/yara_rules/

# Upstream DIE binary (downloaded for differential testing, not committed)
/tools/upstream-die/

# Temporary commit message files
/COMMIT_MSG_*.txt
# Temporary probe output and scripts
/tmp/

# Playwright MCP test artifacts (screenshots, snapshots, console logs)
/.playwright-mcp/
/*.png


# External feedback reports (not for commit, may contain reporter info)
/doc/feedback.md

# C smoke test binary (compiled artifact, not source)
/tests/c/smoke
