{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://die-rust.invalid/schemas/semantic-result-v1.schema.json",
  "title": "DIEC legacy CLI compatibility semantic result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_schema",
    "result",
    "issues",
    "producer",
    "evidence",
    "comparison"
  ],
  "properties": {
    "model_schema": {
      "const": 1
    },
    "result": {
      "enum": [
        "pass",
        "projection_failure"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "pass"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "segment_index",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "document_count_mismatch",
            "document_schema_mismatch",
            "unexpected_json_document",
            "framing_limit_reached"
          ]
        },
        "segment_index": {
          "oneOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "profile",
        "revision",
        "executable_sha256"
      ],
      "properties": {
        "side": {
          "enum": [
            "upstream",
            "rust"
          ]
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_artifact_sha256",
        "canonical_contract_sha256",
        "execution_verification_sha256",
        "canonical_framing_projection_sha256",
        "framing_segments_sha256",
        "raw_streams"
      ],
      "properties": {
        "contract_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_verification_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_framing_projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "framing_segments_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_streams": {
          "$ref": "#/$defs/rawStreamsEvidence"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "termination",
        "streams"
      ],
      "properties": {
        "output": {
          "$ref": "https://die-rust.invalid/schemas/semantic-projection-contract-v1.schema.json#/$defs/output"
        },
        "termination": {
          "$ref": "#/$defs/termination"
        },
        "streams": {
          "$ref": "#/$defs/streams"
        }
      }
    },
    "termination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "exit"
            },
            "code": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 4294967295
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "signal"
          ],
          "properties": {
            "kind": {
              "const": "signal"
            },
            "signal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "limit_ms"
          ],
          "properties": {
            "kind": {
              "const": "timeout"
            },
            "limit_ms": {
              "$ref": "#/$defs/u64"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "error_code"
          ],
          "properties": {
            "kind": {
              "const": "spawn_error"
            },
            "error_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        }
      ]
    },
    "rawStreamsEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr"
      ],
      "properties": {
        "stdout": {
          "$ref": "#/$defs/rawStdoutEvidence"
        },
        "stderr": {
          "$ref": "#/$defs/rawByteStreamEvidence"
        },
        "runtime_log": {
          "$ref": "#/$defs/rawByteStreamEvidence"
        }
      }
    },
    "rawStdoutEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size",
        "segments"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/u64"
        },
        "segments": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/rawSegmentSourceMap"
              },
              {
                "$ref": "#/$defs/documentSegmentSourceMap"
              }
            ]
          }
        }
      }
    },
    "rawByteStreamEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size",
        "records"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/u64"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rawRecordSource"
          }
        }
      }
    },
    "rawSegmentSourceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "records"
      ],
      "properties": {
        "kind": {
          "const": "raw"
        },
        "source": {
          "$ref": "#/$defs/sourceRawSegment"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rawRecordSource"
          }
        }
      }
    },
    "documentSegmentSourceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source"
      ],
      "properties": {
        "kind": {
          "const": "document"
        },
        "source": {
          "$ref": "#/$defs/sourceDocumentSegment"
        }
      }
    },
    "rawRecordSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "size",
        "sha256"
      ],
      "properties": {
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr"
      ],
      "properties": {
        "stdout": {
          "$ref": "#/$defs/stdout"
        },
        "stderr": {
          "$ref": "#/$defs/byteStream"
        },
        "runtime_log": {
          "$ref": "#/$defs/byteStream"
        }
      }
    },
    "stdout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/rawSegment"
              },
              {
                "$ref": "#/$defs/documentSegment"
              }
            ]
          }
        }
      }
    },
    "byteStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rawRecord"
          }
        }
      }
    },
    "encodedBytes": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "text"
          ],
          "properties": {
            "encoding": {
              "const": "utf8"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "base64"
          ],
          "properties": {
            "encoding": {
              "const": "base64"
            },
            "base64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        }
      ]
    },
    "sourceRawSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "offset",
        "size",
        "sha256"
      ],
      "properties": {
        "index": {
          "$ref": "#/$defs/u64"
        },
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceDocumentSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "offset",
        "size",
        "sha256",
        "canonical_json_sha256"
      ],
      "properties": {
        "index": {
          "$ref": "#/$defs/u64"
        },
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_json_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "rawSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "records"
      ],
      "properties": {
        "kind": {
          "const": "raw"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rawRecord"
          }
        }
      }
    },
    "rawRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "line_ending"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/encodedBytes"
        },
        "line_ending": {
          "enum": [
            "none",
            "lf",
            "crlf"
          ]
        }
      }
    },
    "documentSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "document"
      ],
      "properties": {
        "kind": {
          "const": "document"
        },
        "document": {
          "oneOf": [
            {
              "$ref": "#/$defs/normalScan"
            },
            {
              "$ref": "#/$defs/entropy"
            },
            {
              "$ref": "#/$defs/info"
            },
            {
              "$ref": "#/$defs/struct"
            },
            {
              "$ref": "#/$defs/cliError"
            },
            {
              "$ref": "#/$defs/unclassified"
            }
          ]
        }
      }
    },
    "normalScan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "format_candidates",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "normal_scan"
        },
        "format_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/scanNode"
              },
              {
                "$ref": "#/$defs/detection"
              }
            ]
          }
        }
      }
    },
    "scanNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "file_type",
        "info",
        "offset",
        "offset_text",
        "size",
        "size_text",
        "parent_file_part",
        "values"
      ],
      "properties": {
        "kind": {
          "const": "scan_node"
        },
        "file_type": {
          "type": "string"
        },
        "info": {
          "type": "string"
        },
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "offset_text": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "size": {
          "$ref": "#/$defs/u64"
        },
        "size_text": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "parent_file_part": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/scanNode"
              },
              {
                "$ref": "#/$defs/detection"
              }
            ]
          }
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type",
        "name",
        "version",
        "info",
        "display",
        "heuristic",
        "unknown",
        "rule_identity",
        "priority"
      ],
      "properties": {
        "kind": {
          "const": "detection"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "info": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "heuristic": {
          "type": "boolean"
        },
        "unknown": {
          "type": "boolean"
        },
        "rule_identity": {
          "type": "null"
        },
        "priority": {
          "type": "null"
        }
      }
    },
    "entropy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "total",
        "status",
        "records"
      ],
      "properties": {
        "kind": {
          "const": "entropy"
        },
        "total": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entropyRecord"
          }
        }
      }
    },
    "entropyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "offset",
        "size",
        "entropy",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "offset": {
          "$ref": "#/$defs/u64"
        },
        "size": {
          "$ref": "#/$defs/u64"
        },
        "entropy": {
          "type": "number"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "info": {
      "allOf": [
        {
          "$ref": "#/$defs/infoBase"
        },
        {
          "properties": {
            "kind": {
              "const": "info"
            }
          }
        }
      ]
    },
    "struct": {
      "allOf": [
        {
          "$ref": "#/$defs/infoBase"
        },
        {
          "properties": {
            "kind": {
              "const": "struct"
            }
          }
        }
      ]
    },
    "infoBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "enum": [
            "info",
            "struct"
          ]
        },
        "data": {
          "$ref": "#/$defs/infoValue"
        }
      }
    },
    "infoValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entries"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/infoEntry"
              }
            }
          }
        }
      ]
    },
    "infoEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/infoValue"
        }
      }
    },
    "cliError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message"
      ],
      "properties": {
        "kind": {
          "const": "cli_error"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "unclassified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "unclassified"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "value": true
      }
    }
  }
}
