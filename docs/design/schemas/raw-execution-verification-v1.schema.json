{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://die-rust.invalid/schemas/raw-execution-verification-v1.schema.json",
  "title": "DIEC raw execution verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_schema",
    "verifier",
    "result",
    "run_identity",
    "manifest_artifact",
    "verification_budget_bytes",
    "verified_total_bytes",
    "artifacts"
  ],
  "properties": {
    "verification_schema": {
      "const": 1
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "die-raw-execution-verifier"
        },
        "version": {
          "const": 1
        }
      }
    },
    "result": {
      "const": "pass"
    },
    "run_identity": {
      "$ref": "#/$defs/runIdentity"
    },
    "manifest_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "canonical_execution_sha256"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_execution_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "verification_budget_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "verified_total_bytes": {
      "$ref": "#/$defs/u64"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr"
      ],
      "properties": {
        "stdout": {
          "$ref": "#/$defs/verifiedArtifact"
        },
        "stderr": {
          "$ref": "#/$defs/verifiedArtifact"
        },
        "runtime_log": {
          "$ref": "#/$defs/verifiedArtifact"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "runIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "side",
        "platform",
        "producer_profile",
        "producer_revision",
        "case_manifest_sha256",
        "executable_sha256"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "side": {
          "enum": [
            "upstream",
            "rust"
          ]
        },
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9][a-z0-9_]*$"
        },
        "producer_profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "producer_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "case_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "verifiedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "size"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^sha256/[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/u64"
        }
      }
    }
  }
}
