{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://die-rust.invalid/schemas/compatibility-suite-plan-v1.schema.json",
  "title": "DIEC typed legacy compatibility suite plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_plan_schema",
    "suite_id",
    "as_of",
    "upstream_commit",
    "semantic_schema",
    "max_artifact_bytes",
    "cases"
  ],
  "properties": {
    "suite_plan_schema": {
      "const": 1
    },
    "suite_id": {
      "$ref": "#/$defs/id"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "semantic_schema": {
      "type": "integer",
      "minimum": 1
    },
    "max_artifact_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "capability",
        "platform",
        "oracle_profile",
        "comparison_contract",
        "projection_contract",
        "upstream_manifest",
        "upstream_artifact_root",
        "rust_manifest",
        "rust_artifact_root",
        "normalization_policy",
        "waiver_registry"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "capability": {
          "$ref": "#/$defs/id"
        },
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9][a-z0-9_]*$"
        },
        "oracle_profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "comparison_contract": {
          "$ref": "#/$defs/inputArtifact"
        },
        "projection_contract": {
          "$ref": "#/$defs/inputArtifact"
        },
        "upstream_manifest": {
          "$ref": "#/$defs/inputArtifact"
        },
        "upstream_artifact_root": {
          "$ref": "#/$defs/path"
        },
        "rust_manifest": {
          "$ref": "#/$defs/inputArtifact"
        },
        "rust_artifact_root": {
          "$ref": "#/$defs/path"
        },
        "normalization_policy": {
          "oneOf": [
            {
              "$ref": "#/$defs/inputArtifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "waiver_registry": {
          "$ref": "#/$defs/inputArtifact"
        }
      }
    }
  }
}
