{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json",
  "title": "DIEC single-case semantic compatibility audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_audit_schema",
    "auditor",
    "as_of",
    "result",
    "reason",
    "run_identity",
    "case_id",
    "artifacts",
    "comparison",
    "waiver_audit",
    "input_files_unchanged",
    "errors"
  ],
  "properties": {
    "case_audit_schema": {
      "const": 1
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "die-semantic-case-auditor"
        },
        "version": {
          "const": 1
        }
      }
    },
    "as_of": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "infrastructure_error"
      ]
    },
    "reason": {
      "enum": [
        "required_equivalence_met",
        "approved_semantic_differences",
        "raw_only_mismatch_unwaivable",
        "waiver_audit_failed",
        "comparison_blocked",
        "infrastructure_error"
      ]
    },
    "run_identity": {
      "oneOf": [
        {
          "$ref": "https://die-rust.invalid/schemas/semantic-projection-v1.schema.json#/$defs/runIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "case_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "difference_report",
        "waiver_registry",
        "waiver_audit"
      ],
      "properties": {
        "comparison": {
          "$ref": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json#/$defs/artifact"
        },
        "difference_report": {
          "$ref": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json#/$defs/artifact"
        },
        "waiver_registry": {
          "$ref": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json#/$defs/artifact"
        },
        "waiver_audit": {
          "$ref": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json#/$defs/artifact"
        }
      }
    },
    "comparison": {
      "oneOf": [
        {
          "$ref": "https://die-rust.invalid/schemas/semantic-comparison-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "waiver_audit": {
      "oneOf": [
        {
          "$ref": "https://die-rust.invalid/schemas/difference-waiver-audit-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_files_unchanged": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "infrastructure_error"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "comparison_blocked",
              "infrastructure_error"
            ]
          },
          "input_files_unchanged": {
            "const": false
          },
          "errors": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "as_of": {
            "type": "string",
            "format": "date"
          },
          "run_identity": {
            "$ref": "https://die-rust.invalid/schemas/semantic-projection-v1.schema.json#/$defs/runIdentity"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "comparison": {
            "$ref": "https://die-rust.invalid/schemas/semantic-comparison-v1.schema.json"
          },
          "waiver_audit": {
            "$ref": "https://die-rust.invalid/schemas/difference-waiver-audit-v1.schema.json"
          },
          "input_files_unchanged": {
            "const": true
          },
          "errors": {
            "maxItems": 0
          },
          "artifacts": {
            "properties": {
              "comparison": {
                "$ref": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json#/$defs/artifactReference"
              },
              "difference_report": {
                "$ref": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json#/$defs/artifactReference"
              },
              "waiver_registry": {
                "$ref": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json#/$defs/artifactReference"
              },
              "waiver_audit": {
                "$ref": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json#/$defs/artifactReference"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "pass"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "required_equivalence_met",
              "approved_semantic_differences"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "fail"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "raw_only_mismatch_unwaivable",
              "waiver_audit_failed"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "oneOf": [
        {
          "$ref": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json#/$defs/artifactReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "canonical_sha256"
      ],
      "properties": {
        "sha256": {
          "$ref": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json#/$defs/sha256"
        },
        "canonical_sha256": {
          "$ref": "https://die-rust.invalid/schemas/semantic-case-audit-v1.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
