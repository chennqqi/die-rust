{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://die-rust.invalid/schemas/semantic-comparison-v1.schema.json",
  "title": "DIEC audited two-sided semantic comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparison_schema",
    "comparator",
    "result",
    "requirement",
    "run_identity",
    "case_id",
    "contracts",
    "inputs",
    "raw_equality",
    "difference_report_artifact",
    "limit_error"
  ],
  "properties": {
    "comparison_schema": {
      "const": 1
    },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "die-semantic-comparator"
        },
        "version": {
          "const": 1
        }
      }
    },
    "result": {
      "enum": [
        "exact",
        "semantic_equal",
        "different",
        "projection_failure",
        "comparison_limit_reached"
      ]
    },
    "requirement": {
      "$ref": "#/$defs/requirement"
    },
    "run_identity": {
      "$ref": "https://die-rust.invalid/schemas/semantic-projection-v1.schema.json#/$defs/runIdentity"
    },
    "case_id": {
      "$ref": "https://die-rust.invalid/schemas/semantic-projection-v1.schema.json#/$defs/caseId"
    },
    "contracts": {
      "$ref": "#/$defs/contracts"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "raw_equality": {
      "$ref": "#/$defs/rawEquality"
    },
    "difference_report_artifact": {
      "oneOf": [
        {
          "$ref": "#/$defs/differenceArtifact"
        },
        {
          "$ref": "#/$defs/blockedDifferenceArtifact"
        }
      ]
    },
    "limit_error": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "projection_failure",
              "comparison_limit_reached"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "difference_report_artifact": {
            "$ref": "#/$defs/blockedDifferenceArtifact"
          },
          "requirement": {
            "properties": {
              "met": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "difference_report_artifact": {
            "$ref": "#/$defs/differenceArtifact"
          },
          "limit_error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "comparison_limit_reached"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "limit_error": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "limit_error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "exact"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "requirement": {
            "properties": {
              "met": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "semantic_equal"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "requirement": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "required_equivalence": {
                      "const": "semantic"
                    }
                  },
                  "required": [
                    "required_equivalence"
                  ]
                },
                "then": {
                  "properties": {
                    "met": {
                      "const": true
                    }
                  }
                },
                "else": {
                  "properties": {
                    "met": {
                      "const": false
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "different"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "requirement": {
            "properties": {
              "met": {
                "const": false
              }
            }
          },
          "difference_report_artifact": {
            "properties": {
              "difference_count": {
                "minimum": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_equivalence",
        "met"
      ],
      "properties": {
        "required_equivalence": {
          "enum": [
            "exact",
            "semantic"
          ]
        },
        "met": {
          "type": "boolean"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "projection"
      ],
      "properties": {
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_sha256",
            "canonical_contract_sha256"
          ],
          "properties": {
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "canonical_contract_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_sha256"
          ],
          "properties": {
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "rust"
      ],
      "properties": {
        "upstream": {
          "$ref": "#/$defs/sideInput"
        },
        "rust": {
          "$ref": "#/$defs/sideInput"
        }
      }
    },
    "sideInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "projection",
        "raw_streams",
        "raw_observation_sha256",
        "normalization",
        "comparison_sha256"
      ],
      "properties": {
        "producer": {
          "$ref": "https://die-rust.invalid/schemas/semantic-result-v1.schema.json#/$defs/producer"
        },
        "projection": {
          "$ref": "#/$defs/projectionInput"
        },
        "raw_streams": {
          "$ref": "#/$defs/rawStreams"
        },
        "raw_observation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalization": {
          "$ref": "#/$defs/normalization"
        },
        "comparison_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "projectionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "canonical_projection_sha256",
        "result",
        "issues"
      ],
      "properties": {
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result": {
          "enum": [
            "pass",
            "projection_failure"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "https://die-rust.invalid/schemas/semantic-result-v1.schema.json#/$defs/issue"
          }
        }
      }
    },
    "rawStreams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr"
      ],
      "properties": {
        "stdout": {
          "$ref": "#/$defs/streamReference"
        },
        "stderr": {
          "$ref": "#/$defs/streamReference"
        },
        "runtime_log": {
          "$ref": "#/$defs/streamReference"
        }
      }
    },
    "streamReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/u64"
        }
      }
    },
    "normalization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "skipped"
            },
            "reason": {
              "const": "projection_failure"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "output_artifact_sha256",
            "normalized_projection_sha256",
            "policy_artifact",
            "rules_applied"
          ],
          "properties": {
            "kind": {
              "const": "applied"
            },
            "output_artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "normalized_projection_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "policy_artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "canonical_policy_sha256"
              ],
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "canonical_policy_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "rules_applied": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "https://die-rust.invalid/schemas/semantic-normalization-output-v1.schema.json#/$defs/appliedRule"
              }
            }
          }
        }
      ]
    },
    "rawEquality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termination",
        "stdout",
        "stderr",
        "runtime_log",
        "all"
      ],
      "properties": {
        "termination": {
          "type": "boolean"
        },
        "stdout": {
          "type": "boolean"
        },
        "stderr": {
          "type": "boolean"
        },
        "runtime_log": {
          "type": "boolean"
        },
        "all": {
          "type": "boolean"
        }
      }
    },
    "differenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256",
        "canonical_report_sha256",
        "difference_count"
      ],
      "properties": {
        "kind": {
          "const": "report"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "difference_count": {
          "$ref": "#/$defs/u64"
        }
      }
    },
    "blockedDifferenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256",
        "canonical_blocked_sha256",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "blocked"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_blocked_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "enum": [
            "projection_failure",
            "comparison_limit_reached"
          ]
        }
      }
    }
  }
}
