{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Detect It Easy",
  "version": "1.0.1",
  "identifier": "com.die.gui",
  "build": {
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Detect It Easy",
        "width": 900,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "db/": "db/",
      "db_extra/": "db_extra/",
      "db_custom/": "db_custom/",
      "dbs_min/": "dbs_min/",
      "dbs_special/": "dbs_special/",
      "peid_rules/": "peid_rules/",
      "yara_rules/": "yara_rules/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/die/README.md": "../../README.md",
          "/usr/share/die/LICENSE": "../../LICENSE"
        }
      },
      "rpm": {
        "release": "1",
        "files": {
          "/usr/share/die/README.md": "../../README.md",
          "/usr/share/die/LICENSE": "../../LICENSE"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/chennqqi/die-rust/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2NjJGMjI3RkZFQjM5MDIKUldRQ09ldi9KL0ppRm14VWZDckxFY2RIM3JPc05hYk9hc1c2Nlp3T2dxbzZ0K0pMWDVQZ25SY3YK",
      "requireSignedVersion": true
    }
  }
}
