ARG BASE_IMAGE=die-rust/upstream-oracle-cmake:74eaf505@sha256:466102628c3a94b7ab1048f0c24261b1920e61a40029b128763cf79370255040
FROM ${BASE_IMAGE}

RUN set -eux; \
    cmake --build /opt/die-build \
        --config Release \
        --parallel 4; \
    test -x /opt/die-build/src/gui/die; \
    test -x /opt/die-build/src/console/diec; \
    test -x /opt/die-build/src/lite/diel

COPY upstream/audit_linux_cmake_install.py \
    /opt/die-install/audit_linux_cmake_install.py

LABEL org.opencontainers.image.revision="74eaf505c250ab47e709024e9dc41657cd8f2254"
LABEL org.opencontainers.image.source="https://github.com/horsicq/DIE-engine"
LABEL org.opencontainers.image.description="Pinned Linux Qt5 complete CMake install-tree audit environment"

ENTRYPOINT ["/usr/bin/python3", "/opt/die-install/audit_linux_cmake_install.py", "--inside"]
