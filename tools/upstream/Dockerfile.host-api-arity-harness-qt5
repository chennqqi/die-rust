ARG BASE_IMAGE=die-rust/upstream-oracle-cmake:74eaf505
FROM ${BASE_IMAGE}

COPY host_api_arity_harness_main.cpp /tmp/host_api_arity_harness_main.cpp

RUN set -eux; \
    object_dir=/opt/die-build/src/console/CMakeFiles/diec.dir; \
    cd /opt/die-build/src/console; \
    harness_defines="$(sed -n 's/^CXX_DEFINES = //p' "${object_dir}/flags.make")"; \
    harness_includes="$(sed -n 's/^CXX_INCLUDES = //p' "${object_dir}/flags.make")"; \
    harness_flags="$(sed -n 's/^CXX_FLAGS = //p' "${object_dir}/flags.make")"; \
    /usr/bin/c++ ${harness_defines} ${harness_includes} ${harness_flags} \
        -c /tmp/host_api_arity_harness_main.cpp \
        -o /tmp/host_api_arity_harness_main.cpp.o; \
    sed \
        -e 's#CMakeFiles/diec.dir/main_console.cpp.o#/tmp/host_api_arity_harness_main.cpp.o#' \
        -e 's# -o diec # -o die-host-api-arity-harness #' \
        "${object_dir}/link.txt" > /tmp/link-host-api-arity-harness.sh; \
    sh /tmp/link-host-api-arity-harness.sh; \
    test -x /opt/die-build/src/console/die-host-api-arity-harness

LABEL org.opencontainers.image.revision="74eaf505c250ab47e709024e9dc41657cd8f2254"
LABEL org.opencontainers.image.source="https://github.com/horsicq/DIE-engine"
LABEL org.opencontainers.image.description="Research-only Qt 5 HostApi arity oracle harness"
